# =============================================================================
# TalentOS Environment Configuration Example
# Copy to .env (backend) and apps/web/.env.local (frontend) for local usage.
# Never commit real credentials, tokens, or API keys.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=TalentOS
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security & Authentication ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
SIGNED_URL_SECRET=replace-with-a-separate-signing-secret
COOKIE_SECURE=false

# --- Database ---
# PostgreSQL (recommended for Docker / Supabase / production):
# DATABASE_URL=postgresql+psycopg://talentos:talentos@localhost:5432/talentos
# Local zero-Docker fallback (SQLite with foreign keys enabled):
DATABASE_URL=sqlite:///./data/talentos.db

# --- Supabase (Optional Managed Postgres / Auth / Private Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=candidate-documents

# --- Document Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_RESUME_SIZE_MB=5
DOCUMENT_RETENTION_DAYS=180

# --- AI Resume Analysis Provider ---
# Supported: fallback | openai | gemini | ollama
# Leave AI_PROVIDER=fallback (or omit keys) for deterministic rule-based analysis.
AI_PROVIDER=fallback
AI_ALLOW_EXTERNAL_IN_DEMO=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Email Delivery (Optional) ---
# When unconfigured, password reset and verification flows note that SMTP is inactive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@talentos.local

# --- Rate Limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_DEMO_PER_MINUTE=15
RATE_LIMIT_UPLOAD_PER_MINUTE=15

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
